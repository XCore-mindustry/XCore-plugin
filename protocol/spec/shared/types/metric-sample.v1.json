{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:protocol:shared:types:metric-sample:v1",
  "title": "MetricSampleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "type", "labels"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$"
    },
    "type": {
      "type": "string",
      "enum": ["counter", "gauge", "histogram", "info"]
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "not": {
          "const": "server"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "help": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": "number"
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "counts": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "int64",
        "minimum": 0
      }
    },
    "count": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
    },
    "sum": {
      "type": "number"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "counter"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["value"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "gauge"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["value"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "info"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["value"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "histogram"
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["buckets", "counts", "count", "sum"]
      }
    }
  ]
}
