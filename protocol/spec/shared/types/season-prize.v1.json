{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:protocol:shared:types:season-prize:v1",
  "title": "SeasonPrizeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "placeFrom",
    "placeTo",
    "kind",
    "value"
  ],
  "properties": {
    "placeFrom": {
      "type": "integer",
      "minimum": 1
    },
    "placeTo": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "badge",
        "custom"
      ]
    },
    "value": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    }
  }
}
