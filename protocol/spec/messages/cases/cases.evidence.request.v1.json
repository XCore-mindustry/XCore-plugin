{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:protocol:messages:cases:cases.evidence.request:v1",
  "title": "CasesEvidenceRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageType",
    "messageVersion",
    "server",
    "playerUuid"
  ],
  "properties": {
    "messageType": {
      "const": "cases.evidence.request"
    },
    "messageVersion": {
      "const": 1
    },
    "server": {
      "type": "string",
      "minLength": 1
    },
    "playerUuid": {
      "type": "string",
      "minLength": 1
    },
    "chatLines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "windowSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 1800
    }
  }
}
