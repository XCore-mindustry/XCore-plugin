{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:protocol:messages:discord:discord.account.operation.response:v1",
  "title": "DiscordAccountOperationResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageType", "messageVersion", "server", "operationId", "status"],
  "properties": {
    "messageType": {
      "const": "discord.account.operation.response"
    },
    "messageVersion": {
      "const": 1
    },
    "server": {
      "type": "string",
      "minLength": 1
    },
    "operationId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "status": {
      "type": "string",
      "enum": ["success", "rejected", "failed", "unknown"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "linkedAt": {
      "type": "integer",
      "format": "int64",
      "minimum": 0
    }
  }
}
