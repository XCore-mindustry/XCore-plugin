{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:protocol:messages:rating:rating.season.reschedule.request:v1",
  "title": "RatingSeasonRescheduleRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageType",
    "messageVersion",
    "server",
    "ladder",
    "operation",
    "actor"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "extend"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "extendSeconds"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "set-end"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "endsAt"
        ]
      }
    }
  ],
  "properties": {
    "messageType": {
      "const": "rating.season.reschedule.request"
    },
    "messageVersion": {
      "const": 1
    },
    "server": {
      "type": "string",
      "minLength": 1
    },
    "ladder": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "extend",
        "set-end",
        "end-now"
      ]
    },
    "extendSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "endsAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "urn:xcore:protocol:shared:types:actor-ref:v1"
    },
    "reason": {
      "type": "string"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
