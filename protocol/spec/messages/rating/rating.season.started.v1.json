{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:protocol:messages:rating:rating.season.started:v1",
  "title": "RatingSeasonStartedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageType",
    "messageVersion",
    "season",
    "server",
    "occurredAt"
  ],
  "properties": {
    "messageType": {
      "const": "rating.season.started"
    },
    "messageVersion": {
      "const": 1
    },
    "season": {
      "$ref": "urn:xcore:protocol:shared:types:season-ref:v1"
    },
    "previousSeason": {
      "type": "integer",
      "minimum": 1
    },
    "server": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
