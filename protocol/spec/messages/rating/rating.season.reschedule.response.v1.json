{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:protocol:messages:rating:rating.season.reschedule.response:v1",
  "title": "RatingSeasonRescheduleResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageType",
    "messageVersion",
    "server",
    "season",
    "previousEndsAt",
    "ended"
  ],
  "properties": {
    "messageType": {
      "const": "rating.season.reschedule.response"
    },
    "messageVersion": {
      "const": 1
    },
    "server": {
      "type": "string",
      "minLength": 1
    },
    "season": {
      "$ref": "urn:xcore:protocol:shared:types:season-ref:v1"
    },
    "previousEndsAt": {
      "type": "string",
      "format": "date-time"
    },
    "ended": {
      "type": "boolean"
    }
  }
}
