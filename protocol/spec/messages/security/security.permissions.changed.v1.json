{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcore:protocol:messages:security:security.permissions.changed:v1",
  "title": "SecurityPermissionsChangedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messageType",
    "messageVersion",
    "playerUuid",
    "revision"
  ],
  "properties": {
    "messageType": {
      "const": "security.permissions.changed"
    },
    "messageVersion": {
      "const": 1
    },
    "playerUuid": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "sourceServer": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
