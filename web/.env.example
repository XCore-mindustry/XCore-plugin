# Public origin must match the registered Discord redirect URI.
WEB_ORIGIN=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
WEB_SESSION_DAYS=30

# Production: separate credentials (read-only game data; read/write only xcore_web).
GAME_MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGO_DB_NAME=xcore
WEB_MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true
WEB_MONGO_DB_NAME=xcore_web

# Needed only for link/unlink, never for login or statistics.
REDIS_URL=redis://127.0.0.1:6379
# Required for offline unlink: writable server names matching server.name.
# Empty disables offline unlink; no default executor is guessed.
XCORE_ACCOUNT_SERVERS=
