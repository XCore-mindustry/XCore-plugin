  "components": [
    {
      "name": "Window with head",
      "kind": "card",
      "refersTo": "window",
      "description": "A section window: head band with an accent heading and lede, a 3px accent line, then the body.",
      "html": "<section class=\"ds-window\" style=\"--ac:#d79bff;--band:#402c4f\"><header class=\"ds-window-head\"><h2>For developers</h2><p>The libraries XCore runs on, all open source.</p></header><div class=\"ds-line\"></div><div class=\"ds-window-body\"><div class=\"ds-card\">Card content</div></div></section>",
      "css": ".ds-window{background:#1a1d25;border:3px solid #3a3f4f;color:#eef0f5;font-family:var(--font-body),'Golos Text',system-ui,sans-serif;max-width:640px}.ds-window-head{display:grid;gap:6px;padding:22px 18px;background:#2b3040}.ds-window-head h2{margin:0;font-family:var(--font-display),Tektur,'Arial Narrow',sans-serif;font-size:2rem;font-weight:700;line-height:1.05;color:var(--ac)}.ds-window-head p{margin:0;max-width:60ch}.ds-line{height:3px;background:var(--ac)}.ds-window-body{padding:8px}.ds-card{background:#242833;padding:18px}"
    },
    {
      "name": "Title band",
      "kind": "custom",
      "refersTo": "title-band",
      "description": "The kit's card header: band shade, accent title, note, command chips at the right.",
      "html": "<div class=\"ds-band\" style=\"--ac:#ffd37f;--band:#4d4026\"><p class=\"ds-band-title\">Season rating <span class=\"ds-band-note\">· example</span></p><span class=\"ds-band-cmds\"><code class=\"ds-cmd\">/top</code><code class=\"ds-cmd\">/season</code></span></div>",
      "css": ".ds-band{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px 10px;min-height:42px;padding:6px 10px;background:var(--band)}.ds-band-title{margin:0;font-family:var(--font-display),Tektur,'Arial Narrow',sans-serif;font-size:.95rem;font-weight:600;color:var(--ac)}.ds-band-note{font-family:var(--font-body),'Golos Text',sans-serif;font-size:.8125rem;font-weight:400;color:color-mix(in srgb,var(--ac) 45%,#eef0f5)}.ds-band-cmds{display:flex;gap:4px}.ds-cmd{display:inline-block;padding:5px 7px;font-family:var(--font-code),'Fira Code',ui-monospace,monospace;font-size:.8125rem;font-weight:500;line-height:1;font-variant-ligatures:none;white-space:nowrap;color:var(--ac);background:#14161c;border:1px solid color-mix(in srgb,var(--ac) 30%,#3a3f4f)}"
    },
    {
      "name": "Command chip",
      "kind": "chip",
      "refersTo": "command-chip",
      "description": "An in-game command as the player types it, attached to the field it shows.",
      "html": "<div class=\"ds-field\" style=\"--ac:#ffd37f\"><span class=\"ds-field-label\">Playtime</span><span class=\"ds-field-value\">212 h</span><code class=\"ds-cmd\">/stats</code></div>",
      "css": ".ds-field{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:12px;padding:8px 10px 8px 12px;background:#14161c;max-width:420px}.ds-field-label{font-family:var(--font-body),'Golos Text',sans-serif;font-size:.9375rem;color:#b0b6c6}.ds-field-value{font-family:var(--font-display),Tektur,sans-serif;font-size:1.125rem;font-weight:600;color:#eef0f5}.ds-cmd{display:inline-block;padding:5px 7px;font-family:var(--font-code),'Fira Code',ui-monospace,monospace;font-size:.8125rem;font-weight:500;line-height:1;font-variant-ligatures:none;color:var(--ac);background:#14161c;border:1px solid color-mix(in srgb,var(--ac) 30%,#3a3f4f)}"
    },
    {
      "name": "Button",
      "kind": "button",
