      "html": "<button type=\"button\" class=\"ds-btn-target\"><span class=\"ds-btn-target-name\">XCore</span><span class=\"ds-btn-target-hint\">Copy “XCore” for the search</span></button>",
      "css": ".ds-btn-target{display:flex;flex-direction:column;justify-content:center;min-height:56px;padding:6px 20px;color:#14161c;text-align:left;background:#ffd37f;border:0;border-radius:0;cursor:pointer;transition:background-color .2s,transform .2s cubic-bezier(.16,1,.3,1)}.ds-btn-target:hover{background:#ffe2a8}.ds-btn-target:active{transform:translateY(2px)}.ds-btn-target:focus-visible{outline:2px solid #ffd37f;outline-offset:2px}.ds-btn-target-name{font-family:var(--font-display),Tektur,sans-serif;font-size:1.5rem;font-weight:800;line-height:1}.ds-btn-target-hint{margin-top:4px;font-family:var(--font-body),'Golos Text',sans-serif;font-size:.8125rem;font-weight:500;line-height:1.2}"
    },
    {
