      "css": ".ds-btn{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 14px;font-family:var(--font-display),Tektur,'Arial Narrow',sans-serif;font-weight:600;color:#eef0f5;text-decoration:none;background:#2b3040;border:1px solid #3a3f4f;transition:border-color .2s,background-color .2s}.ds-btn:hover{border-color:var(--ac);background:#30364a}.ds-btn:focus-visible{outline:2px solid #ffd37f;outline-offset:2px}"
    },
