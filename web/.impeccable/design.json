      "html": "<nav class=\"ds-tabs\"><a href=\"#\" aria-current=\"page\">RU</a><a href=\"#\">EN</a></nav>",
      "css": ".ds-tabs{display:flex;gap:4px}.ds-tabs a{display:grid;place-items:center;min-width:52px;height:44px;font-family:var(--font-display),Tektur,sans-serif;font-weight:600;color:#b0b6c6;text-decoration:none;background:#14161c;border-bottom:3px solid transparent}.ds-tabs a:hover{color:#eef0f5;background:#30364a}.ds-tabs a[aria-current]{color:#eef0f5;background:#242833;border-bottom-color:#ffd37f}.ds-tabs a:focus-visible{outline:2px solid #ffd37f;outline-offset:2px}"
