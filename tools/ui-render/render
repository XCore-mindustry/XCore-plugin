#!/usr/bin/env bash
# Renders this plugin's menus in the real desktop client with the renderer of mindustry-testkit.
set -euo pipefail
cd "$(dirname "$0")/../.."

testkit="${MINDUSTRY_TESTKIT:-../mindustry-testkit}"
renderer="$testkit/render/render"
if [[ ! -x "$renderer" ]]; then
    echo "The renderer lives in mindustry-testkit: clone it beside this plugin or set MINDUSTRY_TESTKIT." >&2
    exit 2
fi

# Without an input of its own, the run covers every exported fixture.
has_input=false
previous=""
for arg in "$@"; do
    [[ "$arg" == -* || "$previous" == --profiles || "$previous" == --out ]] || has_input=true
    previous="$arg"
done
$has_input || set -- "$@" build/ui-render/packets
./gradlew exportUiFixtures --console=plain
exec "$renderer" --out build/ui-render/results "$@"
