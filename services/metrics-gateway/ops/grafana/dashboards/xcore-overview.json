      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum by (server, result) (rate(xcore_commands_total{server=~\"$server\"}[5m]))", "legendFormat": "{{server}} {{result}}"}],
      "fieldConfig": {"defaults": {"unit": "ops", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 15, "type": "timeseries", "title": "Command latency p95", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 13},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (server, le) (rate(xcore_command_duration_seconds_bucket{server=~\"$server\"}[5m])))", "legendFormat": "{{server}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
