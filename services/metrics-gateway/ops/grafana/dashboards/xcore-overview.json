      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "sum by (server) (rate(mindustry_player_joins_total{server=~\"$server\"}[5m]))", "legendFormat": "{{server}} joins"},
