## Спільні відповіді слеш-команд поза зверненнями. Ідентифікатори починаються з "command-".

command-player-not-found = Гравця не знайдено
command-duplicate = Повтор команди пропущено: цю операцію вже нещодавно виконано.
command-failed = Не вдалося виконати команду (код: { $ref }). Якщо помилка повторюється, повідомте адміністратора.
command-missing-permissions = Бракує прав
command-missing-role = Бракує прав: потрібна роль { $role }
command-missing-roles = Бракує прав: потрібна одна з ролей { $first } або { $second }
command-page-previous = ◀ Назад
command-page-next = Далі ▶
command-sort = Сортування: { $sort }

# Тривалість у хвилинах, як показується час у грі

command-duration-minutes = { $minutes } хв
command-duration-hours = { $hours } год { $minutes } хв
command-duration-days = { $days } д { $hours } год { $minutes } хв
