## Replies shared by the slash commands outside cases. Ids start with "command-".

command-player-not-found = Player not found
command-duplicate = Duplicate command ignored: this operation was already processed recently.
command-failed = Command failed (ref: { $ref }). Report this to an admin if the issue persists.
command-missing-permissions = Missing permissions
command-missing-role = Missing permissions: required role { $role }
command-missing-roles = Missing permissions: required one of roles { $first } or { $second }
command-page-previous = ◀ Prev
command-page-next = Next ▶
command-sort = Sort: { $sort }

# A duration in minutes, the way playtime is shown

command-duration-minutes = { $minutes }m
command-duration-hours = { $hours }h { $minutes }m
command-duration-days = { $days }d { $hours }h { $minutes }m
